{
  "name": "ota-api",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=16.14"
  },
  "resolutions": {
    "@nestjs/schematics": "10.0.1"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm:gen": "rimraf ./src/migrations/*.ts && npx typeorm-ts-node-commonjs migration:generate ./src/migrations/init -d ./src/typeorm.ts",
    "typeorm:run": "npx typeorm-ts-node-commonjs migration:run -d ./src/typeorm.ts",
    "pm2:start": "yarn build && pm2 start ecosystem.config.js && pm2 save && pm2 startup",
    "pm2:restart": "pm2 stop ota-api && yarn build && pm2 restart ota-api --update-env"
  },
  "dependencies": {
    "@nestjs/common": "10.4.16",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.16",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "10.4.16",
    "@nestjs/platform-socket.io": "10.4.16",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "10.4.16",
    "ali-oss": "^6.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "helmet": "^7.2.0",
    "mysql2": "^3.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "10.1.18",
    "@nestjs/schematics": "10.0.1",
    "@nestjs/testing": "10.4.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@types/ali-oss": "^6.23.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^16.18.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
