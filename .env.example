# 项目启动端口
PORT=
# MySQL 数据库地址
ORM_HOST=
# MySQL 数据库端口
ORM_PORT=
# MySQL 数据库用户名
ORM_USERNAME=
# MySQL 数据库密码
ORM_PASSWORD=
# MySQL 数据库名
ORM_DATABASE=
# 阿里OSS bucket
OSS_BUCKER=
# 阿里OSS accessKeyId
OSS_KEY=
# 阿里OSS accessKeySecret
OSS_SECRET=
# 阿里OSS region
OSS_REGION=
# 阿里OSS 存储目录
OSS_DIR=
# 阿里OSS 自定义url
OSS_URL=
# 热更新 ZIP 最大上传字节数，默认 104857600（100 MiB）
OTA_UPLOAD_MAX_BYTES=104857600
# jwt 加密 key
JWT_SECRET=
# 管理员访问 Token 秒数（60–86400），默认 3600；无刷新令牌，过期需重新登录
ADMIN_ACCESS_TOKEN_TTL_SECONDS=3600
# 仅首次初始化使用：随机 32–1024 字符，通过 x-initialization-token 提交；留空禁用初始化
# 初始化完成后删除此配置并重启，勿提交真实密钥
ADMIN_INITIALIZATION_TOKEN=
# 可以发socket的ip，逗号拼接
IPS=
# Express 信任的反向代理跳数；直连部署填 0
TRUST_PROXY_HOPS=1
# 可重发普通消息保存秒数
MESSAGE_RESEND_TTL_SECONDS=86400
# 发布任务暂停开关（故障或回滚时可设为 true，不会放宽筛选）
PUBLISH_TASKS_PAUSED=false
# 发布任务轮询间隔（毫秒）
PUBLISH_TASK_POLL_MS=5000
# 已成功任务/执行记录与审计保留天数
TASK_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
